---
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  ratio?: "square" | "landscape" | "portrait";
  class?: string;
}

const { src, alt, ratio = "square", class: className } = Astro.props;

let width = 800;
let height = 800;

if (ratio === "landscape") {
  width = 1600;
  height = 900;
}

if (ratio === "portrait") {
  width = 800;
  height = 1000;
}

/** Rutas locales (public/) con <img> para que siempre se vean; el resto con Image optimizado */
const isLocalPath = typeof src === "string" && src.startsWith("/");
---
{
  isLocalPath ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      class={className}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      sizes="(max-width: 768px) 100vw, 33vw"
      loading="lazy"
      class={className}
    />
  )
}
