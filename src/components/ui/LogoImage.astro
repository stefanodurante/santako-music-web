---
import SmartImage from "./SmartImage.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`aspect-square overflow-hidden ${className}`}>
  <SmartImage
    src="/logo/santako-music-logo.png"
    alt="Santako Music"
    variant="card"
    class="w-full h-full object-contain"
  />
</div>
